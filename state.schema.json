{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RWA Agent State Memory",
  "description": "合规 RWA 发行 Agent 的跨步骤状态记忆。agent 每完成一步读取并更新此文件，使「尽调→发行→派息」全流程具备连续记忆。这是 MemOS 式结构化记忆在 skill 层的极简落地——不放进合约（链下状态不该上链），而由 harness 在本地维护。这是发行人的主权数据：默认私有、默认 gitignore、永不打包进可分享的子 skill；沉淀敏感信息或对外开放均需记录在 consent 段的显式同意。",
  "type": "object",
  "properties": {
    "ownership": {
      "type": "object",
      "description": "数据主权声明。此文件归发行人所有，默认私有。agent 不得在未记录 consent.shares 同意的情况下把任何私有段（whitelist / personalization / diligence.evidence / dividends 明细）暴露给他人或其他 agent。",
      "properties": {
        "owner": { "type": "string", "description": "发行人标识或地址" },
        "private_by_default": { "type": "boolean", "default": true, "description": "默认私有开关；spawn 出的子 skill 仅含公开操作面，私有账本不复制进包" },
        "notice": { "type": "string", "description": "人类可读的主权声明，例如「本文件含投资者 PII 与尽调证据，分享前需 owner 显式同意」" }
      }
    },
    "consent": {
      "type": "object",
      "description": "显式同意账本——两道同意闸（沉淀 / 开放）的留痕，可审计。未记录对应同意即视为未授权，agent 须按默认私有处理。",
      "properties": {
        "deposits": {
          "type": "array",
          "description": "🔑 沉淀同意：把个人/敏感信息写入私有段前获得的同意记录",
          "items": {
            "type": "object",
            "properties": {
              "scope": { "type": "string", "description": "沉淀范围，如 'personalization.preferences' / 'whitelist.pii'" },
              "granted": { "type": "boolean", "description": "是否获得发行人同意" },
              "at": { "type": "string", "description": "同意时间 ISO8601" },
              "note": { "type": "string", "description": "记录什么、用途、存放位置（仅本地）" }
            },
            "required": ["scope", "granted", "at"]
          }
        },
        "shares": {
          "type": "array",
          "description": "🔑 开放同意：对外暴露 skill 或数据范围前获得的同意 + 权限清单（暴露什么 / 保留什么）",
          "items": {
            "type": "object",
            "properties": {
              "artifact": { "type": "string", "description": "被开放的对象，如 'skills/MPF-asset/' 或导出的 profile" },
              "granted": { "type": "boolean", "description": "是否获得发行人同意；false = 仅自用，未对外" },
              "exposed": { "type": "array", "items": { "type": "string" }, "description": "权限清单·暴露项，如 ['contract_address', 'operation_commands']" },
              "withheld": { "type": "array", "items": { "type": "string" }, "description": "权限清单·保留项，如 ['investor_pii', 'diligence_evidence', 'dividend_detail', 'preferences']" },
              "recipient": { "type": "string", "description": "开放给谁（可选）" },
              "at": { "type": "string" }
            },
            "required": ["artifact", "granted", "exposed", "withheld", "at"]
          }
        }
      }
    },
    "personalization": {
      "type": "object",
      "description": "个性化偏好 profile——主权私有数据。每次 NL 交互可经沉淀同意精炼，使下次发行/操作更贴合发行人需求。默认私有，分享需开放同意。",
      "properties": {
        "preferences": {
          "type": "object",
          "description": "发行人反复确认的默认偏好，发行时用于预填",
          "properties": {
            "jurisdictions": { "type": "array", "items": { "type": "integer" }, "description": "常用司法辖区 ISO 3166 地区码" },
            "allowed_jurisdictions": { "type": "array", "items": { "type": "string" }, "description": "允许投资的 ISO 3166 alpha-2 列表，供 jurisdiction_match 比对" },
            "default_max_holders": { "type": "integer", "description": "默认最大持有人数" },
            "default_max_balance_per_investor": { "type": "string", "description": "默认单投资者持仓上限" },
            "dividend_cadence": { "type": "string", "description": "派息节奏，如 'quarterly'" },
            "disclosure_template": { "type": "string", "description": "披露/文档模板标识" },
            "risk_thresholds": { "type": "object", "description": "自定义风险阈值（如自动拒绝的尽调评级）" }
          }
        },
        "refined_at": { "type": "string", "description": "最近一次精炼时间" },
        "refine_log": {
          "type": "array",
          "description": "精炼历史——每次从交互学到的偏好变更可追溯",
          "items": {
            "type": "object",
            "properties": {
              "change": { "type": "string", "description": "精炼了什么偏好" },
              "from_interaction": { "type": "string", "description": "来源交互摘要" },
              "consented": { "type": "boolean", "description": "是否经沉淀同意" },
              "at": { "type": "string" }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "发行方可配置项。denylist 让尽调闸门具备确定性的拒绝路径（命中即 RED）。",
      "properties": {
        "denylist": {
          "type": "array",
          "description": "禁投地址名单（黑名单/制裁名单）。尽调时若 target 命中，evidence.flag=risk → 评级 RED → 拒绝发行。",
          "items": { "type": "string", "description": "禁投地址" }
        },
        "ofac_oracle": {
          "type": "string",
          "description": "可选：MockOFACRegistry 或链上制裁 Oracle 地址。设置后尽调执行 cast call isSanctioned(address)。"
        },
        "denylist_source": {
          "type": "string",
          "description": "denylist 来源说明，如 assets/knowledge/denylist_ofac_eth.json"
        },
        "blocked_jurisdictions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ISO 3166 alpha-2 禁止认购/分销的司法辖区（Stage −1 distribution_eligibility）"
        },
        "attestation_registry": {
          "type": "string",
          "description": "DiligenceAttestationRegistry 地址；默认读 deployments/attestation_atlantic.json"
        },
        "asset_registry": {
          "type": "string",
          "description": "AssetTokenizationRegistry 地址；用于 #19 duplicate_tokenization 查询"
        }
      }
    },
    "asset": {
      "type": "object",
      "description": "本次发行的 RWA 资产元信息",
      "properties": {
        "name": { "type": "string", "description": "资产名，如 'Manhattan Property Fund'" },
        "symbol": { "type": "string", "description": "代币符号，如 'MPF'" },
        "address": { "type": "string", "description": "部署后的合约地址；为空表示尚未发行" },
        "deployed_at": { "type": "string", "description": "部署时间 ISO8601" },
        "deploy_tx": { "type": "string", "description": "部署交易哈希，可审计" },
        "max_holders": { "type": "integer", "description": "合规规则：最大持有人数" },
        "max_balance_per_investor": { "type": "string", "description": "合规规则：单投资者持仓上限" },
        "compliance_module": {
          "type": "object",
          "description": "发行完成后固化的合规模块摘要（spawn 写入 COMPLIANCE_MODULE.md；不含 PII）",
          "properties": {
            "wrapper_type": {
              "type": "string",
              "enum": ["permissioned_token", "derivative_reference", "closed_custodial", "fund_unit", "freely_transferable"]
            },
            "target_regime": {
              "type": "string",
              "enum": ["mica_eu", "reg_d_us", "reg_s_us", "reg_a_plus", "private_placement", "sandbox", "other"]
            },
            "transferability": {
              "type": "string",
              "enum": ["permissioned_onchain", "closed_custodial", "derivative_reference", "free_transfer_legal_gate"]
            },
            "kyc_placement": {
              "type": "string",
              "enum": ["onchain_identity_registry", "mint_redeem_only", "platform_custodial"]
            },
            "regime_bindings": {
              "type": "object",
              "description": "声明的 target_regime 与链上 CompliantRWAToken 字段映射",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "diligence": {
      "type": "object",
      "description": "发行前的尽调闸门结果（B skill 产出）",
      "properties": {
        "session_id": { "type": "string", "description": "可选尽调会话 id，如 dd-20260618-xyz" },
        "target": { "type": "string", "description": "被尽调地址（托管方/发行方/投资者）" },
        "target_role": {
          "type": "string",
          "enum": ["investor", "custodian", "issuer_self", "intermediary", "underlying_asset", "large_subscriber"],
          "description": "尽调对象角色（aliases: INV/CUS/ISS/INT/SUB）。决定 Stage 1 检查子集"
        },
        "list_snapshots": {
          "type": "object",
          "description": "制裁/名单快照日期（公开事实，无需 consent）",
          "properties": {
            "ofac_eth": { "type": "string", "description": "YYYY-MM-DD，对应 denylist OFAC ETH 快照" }
          }
        },
        "background": {
          "type": "object",
          "description": "Stage 0 链下背景摘要（PII 字段需 deposit consent）",
          "properties": {
            "jurisdiction": { "type": "string", "description": "ISO 3166 alpha-2" },
            "entity_type": { "type": "string", "enum": ["individual", "corporate", "multisig"] },
            "wrapper_type": {
              "type": "string",
              "enum": ["permissioned_token", "derivative_reference", "closed_custodial", "fund_unit", "freely_transferable"]
            },
            "target_regime": {
              "type": "string",
              "enum": ["mica_eu", "reg_d_us", "reg_s_us", "reg_a_plus", "private_placement", "sandbox", "other"]
            },
            "holder_rights_documented": { "type": "boolean" },
            "tokenization_rights_verified": { "type": "boolean", "description": "底层资产代币化授权已核验" },
            "kyc_expiry": { "type": "string", "description": "YYYY-MM-DD" },
            "asset_lien_status": { "type": "string", "enum": ["clear", "encumbered", "unknown"] },
            "large_fiat_source_declared": { "type": "boolean" },
            "consent_granted": { "type": "boolean", "description": "链下字段使用同意；false 则不得执行 off-chain checks" }
          }
        },
        "checks_run": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Stage 2 实际执行的检查项 id 列表"
        },
        "skipped_checks": {
          "type": "array",
          "description": "因角色或配置跳过的检查及原因",
          "items": {
            "type": "object",
            "properties": {
              "check": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["check", "reason"]
          }
        },
        "rating": { "type": "string", "enum": ["GREEN", "YELLOW", "RED", "UNCHECKED"], "description": "红黄绿三档" },
        "passed": { "type": "boolean", "description": "是否通过闸门。false 时 agent 必须拒绝一切发行操作" },
        "checked_at": { "type": "string" },
        "asset_fingerprint": {
          "type": "string",
          "description": "keccak256(asset_id, jurisdiction, wrapper_type) — #19 duplicate_tokenization 与链上注册用"
        },
        "attestation": {
          "type": "object",
          "description": "链上尽调结论存证（哈希 only，无 PII）",
          "properties": {
            "registry": { "type": "string", "description": "DiligenceAttestationRegistry 地址" },
            "asset_registry": { "type": "string", "description": "AssetTokenizationRegistry 地址" },
            "evidence_hash": { "type": "string", "description": "canonical evidence[] 的 keccak256" },
            "tx": { "type": "string", "description": "attest 交易哈希" },
            "at": { "type": "string", "description": "ISO8601" },
            "rating_onchain": { "type": "integer", "enum": [1, 2], "description": "1=YELLOW 2=GREEN（RED 不上链）" }
          }
        },
        "evidence": {
          "type": "array",
          "description": "可验证依据数组——每条结论都能追溯到具体 cast 命令与返回值，规则确定性、可复现",
          "items": {
            "type": "object",
            "properties": {
              "check": { "type": "string", "description": "检查项标识，如 is_contract / tx_count / balance" },
              "cmd": { "type": "string", "description": "cast 命令或链下操作描述（questionnaire:…; verified_by=…）" },
              "verified_by": { "type": "string", "enum": ["manual", "document", "regulator_db", "questionnaire", "explorer"], "description": "链下 evidence 可选：验证方式" },
              "source": { "type": "string", "description": "可选：cast_logs_scan | explorer | unavailable | knowledge_mapping" },
              "list_snapshot": { "type": "string", "description": "制裁比对使用的名单快照日期" },
              "result": { "type": "string", "description": "命令返回的原始值或结构化摘要" },
              "infer": { "type": "string", "description": "从返回值推出的结论" },
              "flag": { "type": "string", "enum": ["ok", "warn", "risk"], "description": "该项的风险标记" }
            },
            "required": ["check", "cmd", "result", "infer", "flag"]
          }
        }
      }
    },
    "whitelist": {
      "type": "array",
      "description": "已注册的合规投资者身份（registerIdentity 的记录）",
      "items": {
        "type": "object",
        "properties": {
          "addr": { "type": "string" },
          "country": { "type": "integer", "description": "ISO 3166 地区码" },
          "tx": { "type": "string", "description": "注册交易哈希" },
          "at": { "type": "string" }
        }
      }
    },
    "dividends": {
      "type": "array",
      "description": "派息历史（depositDividend 的记录）",
      "items": {
        "type": "object",
        "properties": {
          "amount": { "type": "string", "description": "存入的 PHRS 数量" },
          "tx": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    },
    "spawned_skill": {
      "type": "object",
      "description": "发行完成后为本资产沉淀的私有运营 skill。首先服务发行人自己；默认私有（sharing=private），对外开放需 consent.shares 显式同意 + 权限清单。",
      "properties": {
        "generated": { "type": "boolean" },
        "path": { "type": "string", "description": "生成的资产专属 skill 目录" },
        "generated_at": { "type": "string" },
        "sharing": { "type": "string", "enum": ["private", "shared"], "default": "private", "description": "默认 private（仅自用）；shared 需对应 consent.shares 记录" },
        "permission_manifest": { "type": "string", "description": "权限清单文件路径（PERMISSIONS.md）：声明暴露面 vs 保留的私有数据" },
        "version": { "type": "integer", "description": "spawn/refine 进化版本号（meta.json 同步）" },
        "refined_at": { "type": "string", "description": "最近一次 personalization 精炼时间" },
        "evolution_engine": { "type": "string", "description": "进化脚本标识，如 skill_spawn_lib" }
      }
    },
    "progress": {
      "type": "array",
      "description": "Agent 机构汇报轨迹 — 与 .hatchfi/run-events.jsonl harness feed 对齐；供合规官与 Agent 共读",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string", "description": "ISO8601 UTC" },
          "phase": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
          "step": { "type": "string", "description": "Harness step id，如 deploy:pharos" },
          "status": { "type": "string", "enum": ["ok", "fail", "skip", "running", "warn"] },
          "summary": { "type": "string", "description": "一句人读摘要" },
          "tx": { "type": "string" },
          "address": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["at", "phase", "step", "status", "summary"]
      }
    },
    "run_session": {
      "type": "object",
      "description": "最近一次 harness 事件快照 — Agent Run 看板与断点续作",
      "properties": {
        "last_event_at": { "type": "string" },
        "last_step": { "type": "string" },
        "last_status": { "type": "string" },
        "last_phase": { "type": "string", "enum": ["A", "B", "C", "D", "E"] }
      }
    },
    "last_action": { "type": "string", "description": "最近一次操作，用于断点续作" },
    "history": {
      "type": "array",
      "description": "全流程操作流水（审计用，对齐金融可审计要求）",
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "risk": { "type": "string", "enum": ["low", "medium", "high"], "description": "操作风险档（统一风险分级框架）" },
          "confirmed_by_human": { "type": "boolean", "description": "高风险操作是否经人确认" },
          "tx": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    }
  },
  "required": ["asset", "diligence", "whitelist", "dividends", "last_action", "history"]
}
