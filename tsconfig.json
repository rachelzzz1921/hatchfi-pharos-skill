{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"]
  },
  "//": "Node/CLI + the shipped gate primitive + MCP server. Web app is typechecked by tsconfig.web.json.",
  "include": ["lib/**/*.ts", "mcp-server/**/*.ts"]
}
