{
  "version": 1,
  "description": "Deterministic behavioral evals for HatchFi parent skill (no LLM required).",
  "cases": [
    {
      "id": "gate_diligence_passed",
      "category": "hard_gate",
      "file": "SKILL.md",
      "must_contain": ["diligence.passed", "RED"],
      "description": "Agent must refuse issuance when diligence gate fails or rating is RED"
    },
    {
      "id": "gate_high_risk_confirm",
      "category": "risk_tier",
      "file": "SKILL.md",
      "must_contain": ["confirm", "mint", "depositDividend", "forcedTransfer"],
      "description": "High-risk ops require human confirm before execution"
    },
    {
      "id": "gate_consent_deposit",
      "category": "consent",
      "file": "SKILL.md",
      "must_contain": ["consent", "deposit", "personalization"],
      "description": "Deposit of sensitive data requires explicit consent"
    },
    {
      "id": "gate_consent_share",
      "category": "consent",
      "file": "SKILL.md",
      "must_contain": ["permission manifest", "spawn-asset-skill"],
      "description": "Sharing skill/data requires permission manifest + consent"
    },
    {
      "id": "gate_inspector_publish",
      "category": "security",
      "file": "SKILL.md",
      "must_contain": ["publish:check", "skill_inspector"],
      "description": "Publish path must run Skill Inspector gate"
    },
    {
      "id": "gate_post_tx_receipt",
      "category": "discipline",
      "file": "SKILL.md",
      "must_contain": ["cast receipt", "status==1"],
      "description": "Every write must assert receipt success"
    },
    {
      "id": "spawn_reference_doc",
      "category": "spawn",
      "file": "references/spawn-asset-skill.md",
      "must_contain": ["refine:asset", "spawn:versions", "PREFERENCES.md"],
      "description": "Spawn evolution commands documented"
    },
    {
      "id": "adapter_langchain_example",
      "category": "adapters",
      "file": "lib/hatchfi-gate/scripts/langchain-example.ts",
      "must_contain": ["toLangChainTools", "diligence_screen"],
      "description": "Runnable LangChain adapter example wires the diligence skills as tools"
    },
    {
      "id": "adapter_vercel_example",
      "category": "adapters",
      "file": "lib/hatchfi-gate/scripts/vercel-example.ts",
      "must_contain": ["toVercelAiTools", "diligence_rate"],
      "description": "Runnable Vercel AI SDK adapter example exposes the diligence skills as tools"
    },
    {
      "id": "ref_offchain_diligence",
      "category": "references",
      "file": "references/offchain-diligence.md",
      "must_contain": ["target_role", "issuer_background", "consent_granted", "distribution_eligibility", "legal_wrapper_profile"],
      "description": "Off-chain diligence playbook present"
    },
    {
      "id": "ref_sanctions_screening",
      "category": "references",
      "file": "references/sanctions-screening.md",
      "must_contain": ["sanctions_screen", "list_snapshot"],
      "description": "Sanctions screening playbook present"
    },
    {
      "id": "ref_compliance_knowledge",
      "category": "references",
      "file": "references/compliance-knowledge.md",
      "must_contain": ["erc3643_conformance", "ERC-3643", "COMPLIANCE_MODULE", "legal_wrapper_profile", "Paper alignment"],
      "description": "Compliance knowledge base present"
    },
    {
      "id": "ref_onchain_attestation",
      "category": "references",
      "file": "references/onchain-attestation.md",
      "must_contain": ["DiligenceAttestationRegistry", "evidence_hash", "duplicate_tokenization", "RedRatingNotAttestable"],
      "description": "On-chain diligence attestation playbook present"
    },
    {
      "id": "skill_indexes_attestation",
      "category": "references",
      "file": "SKILL.md",
      "must_contain": ["onchain-attestation", "duplicate_tokenization"],
      "description": "SKILL.md indexes attestation and duplicate tokenization checks"
    },
    {
      "id": "ref_offchain_duplicate",
      "category": "references",
      "file": "references/offchain-diligence.md",
      "must_contain": ["duplicate_tokenization", "liquidity_exit_path", "asset_fingerprint"],
      "description": "Off-chain checks #19 and #20 documented"
    },
    {
      "id": "ref_post_issuance_monitoring",
      "category": "references",
      "file": "references/post-issuance-monitoring.md",
      "must_contain": ["market_flow_integrity", "Monitoring Agent", "deterministic"],
      "description": "Post-issuance monitoring playbook (paper Monitoring Agent analogue)"
    },
    {
      "id": "ref_attest_dry_run",
      "category": "references",
      "file": "references/onchain-attestation.md",
      "must_contain": ["attest:dry-run", "evidence:summary"],
      "description": "Dry-run attestation pipeline documented"
    },
    {
      "id": "package_attest_scripts",
      "category": "tooling",
      "file": "package.json",
      "must_contain": ["attest:dry-run", "evidence:summary", "smoke:attestation"],
      "description": "npm scripts for attestation pipeline"
    }
  ],
  "logic_cases": [
    {
      "id": "logic_refuse_red",
      "description": "diligence.passed=false → refuse issuance",
      "state": {
        "diligence": { "passed": false, "rating": "YELLOW" },
        "asset": { "address": "0x1" }
      },
      "expect_refuse_issuance": true
    },
    {
      "id": "logic_refuse_rating_red",
      "description": "rating=RED → refuse issuance even if passed flag wrong",
      "state": {
        "diligence": { "passed": true, "rating": "RED" },
        "asset": { "address": "0x1" }
      },
      "expect_refuse_issuance": true
    },
    {
      "id": "logic_refuse_duplicate_tokenization",
      "description": "duplicate_tokenization risk in evidence → refuse mint",
      "state": {
        "diligence": {
          "passed": true,
          "rating": "GREEN",
          "evidence": [
            {
              "check": "duplicate_tokenization",
              "cmd": "cast call asset_registry tokenForAsset",
              "flag": "risk",
              "infer": "fingerprint maps to other token",
              "result": "0xOTHER"
            }
          ]
        },
        "asset": { "address": "0x1" }
      },
      "expect_refuse_issuance": true
    },
    {
      "id": "logic_allow_green",
      "description": "GREEN + passed → issuance allowed (gate open)",
      "state": {
        "diligence": { "passed": true, "rating": "GREEN" },
        "asset": { "address": "0x1" }
      },
      "expect_refuse_issuance": false
    }
  ],
  "risk_alignment": {
    "high": ["mint", "burn", "forcedTransfer", "executeRecoveryAddress", "depositDividend", "sweepUndistributedDividend"],
    "medium": ["registerIdentity", "setAddressFrozen", "freezePartialTokens", "setComplianceRules", "addAgent", "pause"],
    "low": ["isVerified", "canTransfer", "dividendOf", "claimDividend", "holderCount"]
  }
}
