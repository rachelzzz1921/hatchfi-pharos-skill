# Environment & secrets
.env
.env.local
.env.*.local

# Foundry
cache/
out/
broadcast/
# Ignore vendored Foundry libs but keep our own hatchfi-gate primitive.
# NOTE: must be `lib/*` (not `lib/`) or git won't recurse to re-include the subdir.
lib/*
!lib/hatchfi-gate/
!lib/hatchfi-gate/**

# Node (if any)
node_modules/
dist-web/

# Local agent state (may contain addresses; regenerate on deploy)
state.json

# Spawned skills (generated at runtime) — MPF-asset committed as flywheel proof
skills/*
!skills/MPF-asset/

# Python
scripts/__pycache__/
.DS_Store

# Local dev notes (planning, internal prompts, demo scripts) — never published
.dev/

# Local agent run feed (harness NDJSON — may contain tx hashes, never keys)
.hatchfi/*
!.hatchfi/run-events.example.jsonl

# ui-e2e local audit trail
.ui-e2e-log.ndjson
