{
  "name": "pharos-rwa-skill",
  "private": true,
  "description": "Compliant RWA Issuance Agent — Foundry + Pharos Atlantic deploy scripts",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "check": "./check.sh",
    "inspect:skill": "python3 scripts/skill_inspector.py . --format text --fail-on high",
    "inspect:skill:json": "python3 scripts/skill_inspector.py . --format json --output docs/SKILL_SECURITY_REPORT.json --fail-on high",
    "inspect:skill:md": "python3 scripts/skill_inspector.py . --format markdown --output docs/SKILL_SECURITY_REPORT.md --fail-on high",
    "publish:check": "npm run inspect:skill:md && npm run inspect:skill:json && npm run check",
    "preflight:pharos": "bash scripts/preflight.sh",
    "deploy:pharos": "bash scripts/deploy_pharos.sh",
    "smoke:pharos": "bash scripts/smoke.sh",
    "verify:pharos": "bash scripts/verify.sh",
    "spawn:asset": "python3 scripts/spawn_asset_skill.py",
    "refine:asset": "python3 scripts/refine_asset_skill.py",
    "spawn:versions": "python3 scripts/spawn_skill_versions.py list",
    "spawn:rollback": "python3 scripts/spawn_skill_versions.py rollback",
    "refs:generate": "python3 scripts/generate_contract_refs.py",
    "refs:check": "python3 scripts/generate_contract_refs.py --check-drift",
    "eval:skill": "python3 scripts/run_skill_eval.py",
    "eval:skill:json": "python3 scripts/run_skill_eval.py --format json",
    "badges:update": "python3 scripts/update_badges.py",
    "refresh:ofac": "bash scripts/refresh_ofac_denylist.sh",
    "merge:ofac": "python3 scripts/merge_ofac_denylist.py",
    "diligence:sync": "npm run refresh:ofac && npm run merge:ofac",
    "deploy:mock-ofac": "bash scripts/deploy_mock_ofac.sh",
    "deploy:attestation": "bash scripts/preflight.sh && forge script script/DeployAttestation.s.sol:DeployAttestation --rpc-url ${PHAROS_RPC_URL:-https://atlantic.dplabs-internal.com} --private-key $PRIVATE_KEY --broadcast --slow --legacy --with-gas-price 3000000000 --gas-limit 3500000 && bash scripts/post_deploy_attestation.sh",
    "smoke:attestation": "bash scripts/smoke_attestation.sh",
    "evidence:hash": "python3 scripts/evidence_hash.py",
    "evidence:fingerprint": "python3 scripts/evidence_hash.py --asset-id MPF --jurisdiction US --wrapper-type permissioned_token",
    "evidence:summary": "python3 scripts/state_evidence_summary.py --state state.example.json",
    "attest:dry-run": "bash scripts/attest_dry_run.sh state.example.json",
    "sync:zh-diligence": "python3 scripts/sync_zh_diligence_refs.py",
    "gate:demo": "tsx lib/hatchfi-gate/scripts/demo.ts",
    "gate:cli": "tsx lib/hatchfi-gate/scripts/cli.ts",
    "example:langchain": "tsx lib/hatchfi-gate/scripts/langchain-example.ts",
    "example:vercel": "tsx lib/hatchfi-gate/scripts/vercel-example.ts",
    "gate:test": "tsx lib/hatchfi-gate/scripts/test.ts",
    "judge:package": "npm run gate:test && npm run gate:cli && npm run mcp:probe && npm run judge:readiness",
    "judge:readiness": "node scripts/judge-readiness.mjs",
    "judge:readiness:strict": "STRICT_READINESS=1 node scripts/judge-readiness.mjs",
    "mcp": "tsx mcp-server/index.ts",
    "mcp:probe": "node scripts/mcp-probe.mjs",
    "test:mcp": "node scripts/mcp-probe.mjs",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "ui:e2e": "node scripts/ui-e2e.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "setup": "bash setup.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.54.1",
    "wouter": "^3.10.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  }
}
